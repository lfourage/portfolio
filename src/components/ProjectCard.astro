const primaryLogo = langLogos[tags[0]] ?? null;
---

<div class="card-outer cursor-pointer">
  <div class="glow-wrapper">
    <div class={`project-card-wrapper ${splashClass}`}>
      <div class="card-inner">

        <div class="card-placeholder">
          {primaryLogo && <span set:html={primaryLogo} />}
        </div>

        <div class="card-overlay">
          <p class="font-belle card-desc">{description}</p>
          <div class="card-links">
            {liveUrl && (
              <a href={liveUrl} target="_blank" class="card-link font-vcr">Live ↗</a>
            )}
            <a href={githubUrl} target="_blank" class="card-link font-vcr">GitHub ↗</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="card-footer">
    <p class="font-vcr card-title">{name}</p>
    <div class="tags-row">
      {tags.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</div>

<style>
  .card-outer {
    width: min(360px, 90vw);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .glow-wrapper {
    transition: filter 0.4s ease;
    width: 100%;
    aspect-ratio: 4/3;
    position: relative;
  }

  .card-outer:hover .glow-wrapper {
    animation: glow-pulse 1.5s ease-in-out infinite;
  }

  .project-card-wrapper {
    position: absolute;
    inset: 0;
    transition: clip-path 0.4s ease, transform 0.4s ease;
  }

  .card-outer:hover .project-card-wrapper {
    transform: scale(1.04);
  }

  .splash-1 { clip-path: polygon(8% 0%, 94% 2%, 100% 88%, 85% 100%, 5% 95%, 0% 12%); }
  .splash-2 { clip-path: polygon(5% 4%, 90% 0%, 98% 10%, 95% 92%, 12% 100%, 0% 85%, 2% 5%); }
  .splash-3 { clip-path: polygon(10% 0%, 92% 3%, 100% 15%, 96% 90%, 80% 100%, 4% 96%, 0% 8%); }
  .splash-4 { clip-path: polygon(3% 8%, 88% 0%, 100% 5%, 97% 88%, 90% 100%, 8% 98%, 0% 90%, 2% 3%); }

  .card-outer:hover .splash-1 { clip-path: polygon(5% 2%, 97% 0%, 98% 85%, 88% 100%, 2% 97%, 0% 8%); }
  .card-outer:hover .splash-2 { clip-path: polygon(3% 2%, 93% 0%, 100% 8%, 97% 95%, 8% 100%, 0% 88%, 0% 3%); }
  .card-outer:hover .splash-3 { clip-path: polygon(8% 2%, 95% 0%, 100% 12%, 98% 93%, 75% 100%, 2% 98%, 0% 5%); }
  .card-outer:hover .splash-4 { clip-path: polygon(0% 5%, 90% 0%, 100% 3%, 99% 90%, 92% 100%, 5% 100%, 0% 93%, 0% 0%); }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--dark);
  }

  /* Placeholder : logo centré sur fond dégradé synthwave */
  .card-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 50% 50%, var(--violet-darker), var(--dark) 80%);
    transition: filter 0.4s ease;
  }

  .card-outer:hover .card-placeholder {
    filter: brightness(0.35);
  }

  .card-placeholder span {
    display: flex;
    width: 45%;
    height: 45%;
    filter: drop-shadow(0 0 18px var(--pink)) drop-shadow(0 0 36px var(--violet));
  }

  .card-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .card-outer:hover .card-img {
    transform: scale(1.05);
    filter: brightness(0.3);
  }

  /* Overlay hover */
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .card-outer:hover .card-overlay {
    opacity: 1;
  }

  .card-desc {
    color: var(--gold);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    text-align: center;
    text-shadow: 1px 1px 4px var(--dark);
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .card-link {
    padding: 4px 14px;
    border: 2px solid var(--gold);
    color: var(--gold);
    font-size: clamp(0.7rem, 1vw, 0.85rem);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .card-link:hover {
    background: var(--gold);
    color: var(--dark);
  }

  /* Footer hors clip */
  .card-footer {
    padding: 0 4px;
  }

  .card-title {
    color: var(--gold);
    font-size: clamp(0.75rem, 1.3vw, 1rem);
    text-shadow: 1px 1px 4px var(--dark);
    margin-bottom: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tag {
    font-family: "vcr";
    font-size: 0.6rem;
    padding: 2px 6px;
    background: var(--violet);
    color: var(--azure);
    border: 1px solid var(--pink);
    white-space: nowrap;
  }
</style>
